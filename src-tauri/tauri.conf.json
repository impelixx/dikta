{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dikta",
  "version": "0.1.0",
  "identifier": "com.impelix.dikta",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Дикта",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "msi", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [
        "Frameworks/libonnxruntime.1.17.1.dylib",
        "Frameworks/libsherpa-onnx-c-api.dylib",
        "Frameworks/libsherpa-onnx-cxx-api.dylib"
      ],
      "dmg": {
        "windowSize": { "width": 540, "height": 380 },
        "appPosition": { "x": 140, "y": 190 },
        "applicationFolderPosition": { "x": 400, "y": 190 }
      }
    }
  }
}
